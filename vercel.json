{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "vite build && cp -r attached_assets dist/public/attached_assets",
  "outputDirectory": "dist/public",
  "framework": null,
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
